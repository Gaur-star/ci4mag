<style>
#navArea .navbar-inverse {
    min-height: auto !important;
    background-color: #fff;
    box-shadow: 0 3px 4px 0 rgb(0 0 0 / 3%);
}
#navArea #navbar {
    display: flex !important;
    width: 100%;
    align-items: center;
}
#navArea .search_icon  {
    margin-left: auto;
}
#navArea .navbar-inverse .navbar-nav>li>a {
    color: #333333;
    display: block;
    padding: 0 15px;
    position: relative;
    text-transform: uppercase;
    font-weight: 700;
    margin-right: 3px;
    background: transparent;
    z-index: 2;
    font-size: 13px;
    border-left: none;
    text-shadow: none;
    height: auto;
    line-height: inherit;
    position: relative;
    z-index: 2;
    -webkit-transition: all 0.3s ease;
    -o-transition: all 0.3s ease;
    transition: all 0.3s ease;
    font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
}
#navArea .navbar-inverse .navbar-nav>li>a::before {
    content: "";
    width: 100%;
    height: 2px;
    position: absolute;
    top: 0;
    left: 0;
    background-color: #34b0fa;
    z-index: -1;
    -webkit-transition: all 0.3s ease;
    -o-transition: all 0.3s ease;
    transition: all 0.3s ease;
}
#navArea .navbar-inverse .navbar-nav>li>a:hover::before {
    height: 100%;
    -webkit-transition: all 0.3s ease;
    -o-transition: all 0.3s ease;
    transition: all 0.3s ease;
}
#navArea .navbar-inverse .navbar-nav>li>a:hover {
    color: #fff;
    -webkit-transition: all 0.3s ease;
    -o-transition: all 0.3s ease;
    transition: all 0.3s ease;
}

#navArea .navbar-inverse .navbar-nav .home a{
    background: #34b0fa;
    font-size: 18px;
    color: #fff;
}
.humberg_btn {
    display: none;
    border: 1px solid #34b0fa;
    padding: 0 10px;
    border-radius: 4px;
    cursor: pointer;
    color: #34b0fa;
}

@media (max-width: 767.98px) {
    .humberg_btn {
    display: block;
}
.nav.navbar-nav.main_nav {
    display: grid;
    position: absolute;
    top: 100%;
    left: 15px;
    background: #fff;
    z-index: 9;
    width: 100%;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.15s ease-out;
}
.nav.navbar-nav.main_nav.is_active {
    max-height: 500px;
    visibility: visible;
    transition: max-height 0.15s ease-out;
}
#navbar {
