                                                    src="<?php if(empty($second_row['fetch_post']['path']['url'])){echo $settings[12]['setting_value'];}else{echo $second_row['fetch_post']['path']['url'];}?>"
                                                    
                                                    class="attachment-news-vibrant-block-thumb size-news-vibrant-block-thumb wp-post-image lazy"
                                                    alt="" onerror="myFunction(this)" loading="lazy"/> </a>
                                        </div><!-- .nv-post-thumb -->
                                        <div class="nv-post-content">
                                            <h3 class="nv-post-title small-size"><a
                                                    href="<?php echo $second_row['fetch_post']['url']?>"><?php echo substr($second_row['title'], 0, 70);?></a></h3>
                                            <div class="nv-post-meta">
                                                <span class="posted-on"><a
                                                        href="<?php echo $second_row['fetch_post']['url']?>"
                                                        rel="bookmark"><time class="entry-date published updated"
                                                            datetime="2022-08-09T08:00:05-04:00"><?php echo date("d M, Y", strtotime($second_row['update_date']));?></a></span>
                                            </div>
                                        </div><!-- .nv-post-content -->
                                    </div> <!-- nv-single-post -->
                                </div><!-- .nv-single-post-wrap -->
                            <?php }?>




                        </div>
                        <!--- .nv-block-wrapper -->
                    </section>
                </div>





            </div><!-- .cv-container -->
        </div><!-- #content -->
