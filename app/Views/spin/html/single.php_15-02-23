    if (isset($relatedPost)) {


      foreach ($relatedPost as $let) {
        if (
          $let["title"] != $single["title"]
        ) { ?>
          <li>
            <div class="media">
              <a href="<?php echo base_url() . "/" . $let["seo_url"] ?>" class="media-left">
                <img width="272" height="140" src="<?php if (!empty($let["url"])) {
                            echo $let["url"];
                          } else {
                            echo base_url() . '/' . $settings[12]["setting_value"];
                          }
                          ?>" onerror="myFunction(this)"> </a>
              <div class="media-body">
                <a href="<?php echo base_url() . "/" . $let["seo_url"] ?>" class="catg_title"> <?php echo $let["title"] ?></a>
              </div>
            </div>
          </li>
    <?php }
      }
    }
    ?>
  </ul>
